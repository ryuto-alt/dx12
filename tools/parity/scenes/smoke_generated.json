{
  "$schema": "./schema.json",
  "specVersion": 1,
  "id": "smoke_generated",
  "title": "スモーク(生成シーンで基盤を通しで試す。視覚回帰用)",
  "description": "PS-0 の生成器が作る使い捨てシーンを撮って、承認済み baseline と比べる。基盤の動作確認と、エンジン変更後の「絵が変わっていないか」の確認に使う。基準は previous-run(parity baseline update → approve の後に check)。",
  "status": "ready",
  "notes": [
    "手順: parity baseline update tools/parity/scenes/smoke_generated.json → 目視 → parity baseline approve tools/parity/scenes/smoke_generated.json --reason \"初回\" → parity baseline check ..."
  ],

  "scene": { "source": "generator", "script": "gen/ps0_calibration.py", "args": { "sun_intensity": 3.0 }, "scene": "scenes/smoke_generated.json" },

  "cameras": [
    { "name": "overview", "position": [0.0, 1.6, -3.5], "target": [0.0, 0.7, 3.0] },
    { "name": "patches", "position": [-0.4, 1.0, -0.6], "target": [-0.4, 0.9, 2.0] }
  ],

  "engine": { "mode": "headless", "warmupFrames": 30, "settleFrames": 8, "png": "gamma22" },

  "reference": { "kind": "previous-run", "previousRun": { "source": "baseline" } },

  "alignment": { "tonemap": "engine_aces", "exposure": "none", "sizePolicy": "error" },

  "gates": {
    "G0": { "lum_mean_ev_abs_max": 1.0 },
    "G1": { "flip_ldr_mean_max": 0.15, "ssim_min": 0.75 },
    "G2": { "flip_ldr_mean_max": 0.08, "ssim_min": 0.90 }
  },

  "regression": { "flip_ldr_mean_max": 0.002, "flip_ldr_p95_max": 0.01, "ssim_min": 0.995, "de2000_p95_max": 1.0, "lum_mean_ev_abs_max": 0.02 },

  "perf": { "enabled": false }
}
