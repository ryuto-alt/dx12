# ctest から呼ぶ: tools/parity の pytest を回す。Python か依存が無い環境では「スキップ」(ctest 側で SKIP_REGULAR_EXPRESSION)。
#   cmake -DPARITY_DIR=<tools/parity> [-DPARITY_PYTHON=<依存入りの python>] [-DPARITY_REQUIRED=ON] -P run_pytests.cmake
# PARITY_REQUIRED(-D または環境変数)が真なら、スキップせず失敗にする(ゲートで「走らなかった」を緑にしない。FU-L-6)。
if(NOT PARITY_DIR)
    message(FATAL_ERROR "PARITY_DIR が要る")
endif()
if(NOT PARITY_PYTHON AND DEFINED ENV{PARITY_PYTHON})
    set(PARITY_PYTHON "$ENV{PARITY_PYTHON}")
endif()
if(NOT PARITY_REQUIRED AND DEFINED ENV{PARITY_REQUIRED})
    set(PARITY_REQUIRED "$ENV{PARITY_REQUIRED}")
endif()
macro(_parity_skip _msg)
    if(PARITY_REQUIRED)
        message(FATAL_ERROR "PARITY_REQUIRED: ${_msg}")
    else()
        message("PARITY_SKIP: ${_msg}")
        return()
    endif()
endmacro()
set(_py "")
if(PARITY_PYTHON)
    set(_py "${PARITY_PYTHON}")
endif()
if(NOT _py)
    foreach(_c "${PARITY_DIR}/.venv/Scripts/python.exe" "${PARITY_DIR}/.venv/bin/python")
        if(EXISTS "${_c}")
            set(_py "${_c}")
            break()
        endif()
    endforeach()
endif()
if(NOT _py)
    # 通常変数 _py が "" のままだと find_program の結果(キャッシュ)が隠れて常にスキップになるので、先に消す
    unset(_py)
    find_program(_py NAMES python python3)
endif()
if(NOT _py)
    _parity_skip("Python が見つからない(tools/parity/setup.ps1 で venv を作ると走る)")
endif()
execute_process(COMMAND "${_py}" -c "import numpy, scipy, PIL, skimage, flip_evaluator, jsonschema, pytest"
                RESULT_VARIABLE _r OUTPUT_QUIET ERROR_QUIET)
if(NOT _r EQUAL 0)
    _parity_skip("依存が足りない(pwsh tools/parity/setup.ps1 で入る): ${_py}")
endif()
execute_process(COMMAND "${_py}" -m pytest -q "${PARITY_DIR}/tests"
                WORKING_DIRECTORY "${PARITY_DIR}" RESULT_VARIABLE _r)
if(NOT _r EQUAL 0)
    message(FATAL_ERROR "tools/parity の pytest が失敗(終了コード ${_r})")
endif()
