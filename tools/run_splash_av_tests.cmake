# ctest から呼ぶ: 起動画面の A/V 検査（tools/check_splash_av.py / splash_golden.py / splash_av_preview.py）の Python テスト。
#   cmake -DSPLASH_AV_TOOLS=<tools> [-DSPLASH_AV_PYTHON=<numpy と Pillow の入った python>] [-DSPLASH_AV_REQUIRED=ON] -P run_splash_av_tests.cmake
# Python の探し順: SPLASH_AV_PYTHON(-D または環境変数)→ tools/parity/.venv → PATH 上の python。
# numpy / Pillow が無ければスキップ扱い(ctest 側で SKIP_REGULAR_EXPRESSION)。SPLASH_AV_REQUIRED が真なら失敗にする(ゲートで「走らなかった」を緑にしない)。
# 窓は出さない・エンジンは起動しない・実音は鳴らさない（合成のダンプだけを検査する）。
if(NOT SPLASH_AV_TOOLS)
    message(FATAL_ERROR "SPLASH_AV_TOOLS が要る")
endif()
if(NOT SPLASH_AV_PYTHON AND DEFINED ENV{SPLASH_AV_PYTHON})
    set(SPLASH_AV_PYTHON "$ENV{SPLASH_AV_PYTHON}")
endif()
if(NOT SPLASH_AV_REQUIRED AND DEFINED ENV{SPLASH_AV_REQUIRED})
    set(SPLASH_AV_REQUIRED "$ENV{SPLASH_AV_REQUIRED}")
endif()
macro(_splash_av_skip _msg)
    if(SPLASH_AV_REQUIRED)
        message(FATAL_ERROR "SPLASHAV_REQUIRED: ${_msg}")
    else()
        message("SPLASHAV_SKIP: ${_msg}")
        return()
    endif()
endmacro()
unset(_py)
if(SPLASH_AV_PYTHON)
    set(_py "${SPLASH_AV_PYTHON}")
endif()
if(NOT _py)
    foreach(_c "${SPLASH_AV_TOOLS}/parity/.venv/Scripts/python.exe" "${SPLASH_AV_TOOLS}/parity/.venv/bin/python")
        if(EXISTS "${_c}")
            set(_py "${_c}")
            break()
        endif()
    endforeach()
endif()
if(NOT _py)
    unset(_py)
    unset(_py CACHE)
    find_program(_py NAMES python python3)
endif()
if(NOT _py)
    _splash_av_skip("Python が見つからない")
endif()
execute_process(COMMAND "${_py}" -c "import numpy, PIL" RESULT_VARIABLE _r OUTPUT_QUIET ERROR_QUIET)
if(NOT _r EQUAL 0)
    _splash_av_skip("numpy / Pillow が足りない: ${_py}")
endif()
execute_process(COMMAND "${_py}" "${SPLASH_AV_TOOLS}/test_splash_av.py"
                WORKING_DIRECTORY "${SPLASH_AV_TOOLS}" RESULT_VARIABLE _r)
if(NOT _r EQUAL 0)
    message(FATAL_ERROR "tools/test_splash_av.py が失敗(終了コード ${_r})")
endif()
