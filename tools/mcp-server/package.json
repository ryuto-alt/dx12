{
  "name": "dx12-engine-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for the DX12 game engine — drive the live editor from Codex / Claude Code",
  "scripts": {
    "start": "node index.ts",
    "test": "node scripts/run_tests.mjs",
    "test:offline": "node scripts/run_tests.mjs --offline",
    "check:anchors": "node ../check_anchors.mjs",
    "gen:legacy-snapshot": "node scripts/gen_legacy_snapshot.mjs",
    "check:legacy-snapshot": "node scripts/gen_legacy_snapshot.mjs --check",
    "gen:manifest-snapshot": "node scripts/gen_manifest_snapshot.mjs",
    "gen:scene-spec-guide": "node scripts/gen_scene_spec_guide.mjs",
    "check:scene-spec-guide": "node scripts/gen_scene_spec_guide.mjs --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "pngjs": "^7.0.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.24.1"
  }
}
