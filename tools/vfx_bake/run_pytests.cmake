# ctest から呼ぶ: tools/vfx_bake の pytest を回す。Python / numpy / pytest が無い環境ではスキップ扱い(ctest 側で SKIP_REGULAR_EXPRESSION)。
#   cmake -DVFX_BAKE_DIR=<tools/vfx_bake> [-DVFX_BAKE_PYTHON=<pytest と numpy の入った python>] [-DVFX_BAKE_REQUIRED=ON] -P run_pytests.cmake
# Python の探し順: VFX_BAKE_PYTHON(-D または環境変数)→ tools/parity/.venv → PATH 上の python。
# VFX_BAKE_REQUIRED(-D または環境変数)が真なら、スキップせず失敗にする(ゲートで「走らなかった」を緑にしないため)。
if(NOT VFX_BAKE_DIR)
    message(FATAL_ERROR "VFX_BAKE_DIR が要る")
endif()
if(NOT VFX_BAKE_PYTHON AND DEFINED ENV{VFX_BAKE_PYTHON})
    set(VFX_BAKE_PYTHON "$ENV{VFX_BAKE_PYTHON}")
endif()
if(NOT VFX_BAKE_REQUIRED AND DEFINED ENV{VFX_BAKE_REQUIRED})
    set(VFX_BAKE_REQUIRED "$ENV{VFX_BAKE_REQUIRED}")
endif()
macro(_vfx_skip _msg)
    if(VFX_BAKE_REQUIRED)
        message(FATAL_ERROR "VFXBAKE_REQUIRED: ${_msg}")
    else()
        message("VFXBAKE_SKIP: ${_msg}")
        return()
    endif()
endmacro()
# 注意: -P スクリプトでは、空の通常変数が find_program のキャッシュ結果を隠す。_py は先に unset してから使う。
unset(_py)
if(VFX_BAKE_PYTHON)
    set(_py "${VFX_BAKE_PYTHON}")
endif()
if(NOT _py)
foreach(_c "${VFX_BAKE_DIR}/../parity/.venv/Scripts/python.exe" "${VFX_BAKE_DIR}/../parity/.venv/bin/python")
    if(EXISTS "${_c}")
        set(_py "${_c}")
        break()
    endif()
endforeach()
endif()
if(NOT _py)
    unset(_py)
    unset(_py CACHE)
    find_program(_py NAMES python python3)
endif()
if(NOT _py)
    _vfx_skip("Python が見つからない")
endif()
execute_process(COMMAND "${_py}" -c "import numpy, pytest" RESULT_VARIABLE _r OUTPUT_QUIET ERROR_QUIET)
if(NOT _r EQUAL 0)
    _vfx_skip("numpy / pytest が足りない: ${_py}")
endif()
execute_process(COMMAND "${_py}" -m pytest -q "${VFX_BAKE_DIR}/tests"
                WORKING_DIRECTORY "${VFX_BAKE_DIR}" RESULT_VARIABLE _r)
if(NOT _r EQUAL 0)
    message(FATAL_ERROR "tools/vfx_bake の pytest が失敗(終了コード ${_r})")
endif()
