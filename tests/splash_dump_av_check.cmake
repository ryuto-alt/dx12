# --splash-dump の A/V 検証用の出力の形を確かめる（W1-BD8）。窓なし・音デバイスなし・WARP。
# 使い方: cmake -DENGINE=<DX12Engine.exe> -DOUT=<dir> -P splash_dump_av_check.cmake
file(REMOVE_RECURSE "${OUT}")
execute_process(COMMAND "${ENGINE}" --splash-dump "${OUT}" --splash-fps 120 --splash-warp
                RESULT_VARIABLE rc OUTPUT_VARIABLE so ERROR_VARIABLE se TIMEOUT 240)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "splash-dump が失敗: rc=${rc}\n${so}\n${se}")
endif()
foreach(f frames.csv av.json audio.wav)
    if(NOT EXISTS "${OUT}/${f}")
        message(FATAL_ERROR "${f} が出ていません")
    endif()
endforeach()
file(SIZE "${OUT}/audio.wav" wavSize)
if(wavSize LESS 100000)
    message(FATAL_ERROR "audio.wav が小さすぎます: ${wavSize}")
endif()
file(READ "${OUT}/av.json" av)
foreach(k "\"fps\"" "\"dpiScale\"" "\"audio\"" "\"audioOriginMs\"" "\"hub\"" "\"needleLenPx\"" "\"hubRadiusPx\"")
    string(FIND "${av}" "${k}" pos)
    if(pos LESS 0)
        message(FATAL_ERROR "av.json に ${k} がありません")
    endif()
endforeach()
file(READ "${OUT}/frames.csv" csv)
string(FIND "${csv}" "
" nlPos)
string(SUBSTRING "${csv}" 0 ${nlPos} header)
string(STRIP "${header}" header)
set(want "index,tMs,needleDeg,locked,file,t,phase,percent,event,frame,gpu_ms,cpu_ms")
if(NOT header STREQUAL want)
    message(FATAL_ERROR "csv の列が違います: ${header}")
endif()
string(FIND "${csv}" "|" barPos)
if(NOT barPos EQUAL -1)
    message(FATAL_ERROR "event 列の区切りは ';' です（'|' が含まれています）")
endif()
string(REGEX MATCHALL ",click:0,[0-9]+," m1 "${csv}")
# ';' はリストの区切りなので、MATCHALL の個数ではなく「1 回消したら 2 つ目が無い」で数える
string(REGEX MATCH ",latch:0;sub:0;sub:1;tok:0,[0-9]+," l1 "${csv}")
set(nLatch 0)
if(NOT l1 STREQUAL "")
    set(nLatch 1)
    string(REPLACE "${l1}" "" csv2 "${csv}")
    string(REGEX MATCH ",latch:0;sub:0;sub:1;tok:0,[0-9]+," l2 "${csv2}")
    if(NOT l2 STREQUAL "")
        set(nLatch 2)
    endif()
endif()
list(LENGTH m1 nClick0)
if(NOT nClick0 EQUAL 1 OR NOT nLatch EQUAL 1)
    message(FATAL_ERROR "click:0 / 'latch:0;sub:0;sub:1;tok:0' は 1 回ずつのはず: click:0=${nClick0} latch=${nLatch}")
endif()
message(STATUS "splash dump A/V OK")
