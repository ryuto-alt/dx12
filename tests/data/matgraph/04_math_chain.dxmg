{
  "version": 1,
  "kind": "material",
  "guid": "g0000004",
  "name": "math_chain",
  "settings": { "blendMode": "Opaque", "maskClip": 0.5, "shadingModel": "DefaultLit", "twoSided": false },
  "nodes": {
    "ab": { "type": "Abs", "in": { "X": "wave.Out" } },
    "cA": { "type": "Float3", "props": { "value": [0.9, 0.2, 0.1] } },
    "cB": { "type": "Float3", "props": { "value": [0.1, 0.3, 0.8] } },
    "clamped": { "type": "Clamp", "in": { "Max": 0.95, "Min": 0.05, "X": "mix.Out" } },
    "cs": { "type": "Cos", "in": { "X": "ab.Out" } },
    "inv": { "type": "OneMinus", "in": { "X": "ss.Out" } },
    "mix": { "type": "Lerp", "in": { "A": "cA.Out", "Alpha": "ss.Out", "B": "cB.Out" } },
    "mn": { "type": "Min", "in": { "A": "sat.Out", "B": 0.9 } },
    "mx": { "type": "Max", "in": { "A": "mn.Out", "B": 0.1 } },
    "norm": { "type": "Multiply", "in": { "A": "wave.Out", "B": 0.5 } },
    "norm01": { "type": "Add", "in": { "A": "norm.Out", "B": 0.5 } },
    "out": { "type": "MaterialOutput", "in": { "BaseColor": "clamped.Out", "Metallic": "sq.Out", "Roughness": "mx.Out" } },
    "pw": { "type": "Power", "in": { "Base": "norm01.Out", "Exp": 2.2 } },
    "sat": { "type": "Saturate", "in": { "X": "inv.Out" } },
    "scale": { "type": "Float", "props": { "value": 0.5 } },
    "scaled": { "type": "Multiply", "in": { "A": "wp.Out", "B": "scale.Out" } },
    "sq": { "type": "Sqrt", "in": { "X": "cs.Out" } },
    "ss": { "type": "Smoothstep", "in": { "Max": 0.8, "Min": 0.2, "X": "pw.Out" } },
    "wave": { "type": "Sin", "in": { "X": "scaled.Out" } },
    "wp": { "type": "WorldPosition" }
  },
  "comments": {},
  "layout": {
    "ab": "0 0",
    "cA": "0 0",
    "cB": "0 0",
    "clamped": "0 0",
    "cs": "0 0",
    "inv": "0 0",
    "mix": "0 0",
    "mn": "0 0",
    "mx": "0 0",
    "norm": "0 0",
    "norm01": "0 0",
    "out": "0 0",
    "pw": "0 0",
    "sat": "0 0",
    "scale": "0 0",
    "scaled": "0 0",
    "sq": "0 0",
    "ss": "0 0",
    "wave": "0 0",
    "wp": "0 0"
  }
}
