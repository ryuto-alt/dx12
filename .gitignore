# MCP config (contains API tokens)
.mcp.json

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
x64/
x86/
Debug/
Release/
*.obj
# 上の *.obj は MSVC のオブジェクトファイル除け。Wavefront OBJ のテスト素材は残す
# （gitignore は行末コメントを解釈しないので必ず独立行に書くこと）
!tests/data/*.obj
*.pdb
*.ilk
*.exe
*.dll
*.lib
*.log

# Legacy VS project
dx12/

# Build output
build/
out/
bin/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeSettings.json

# vcpkg
vcpkg_installed/

# VS Code
.vscode/

# ユーザーごとの設定（音量・解像度・VSync など）。エディタが assets の隣に書く。
# 以前は末尾スラッシュの取りこぼしで assets/ の中に落ちていた（= game.pak に混ざる）。
/settings.json
/assets/settings.json

# UI テスト/エンジン診断が検査前のシーンを退避する場所。--ui-tests-run-all は
# 復元を待たずに exe が終わるので消し残る（毎回 7KB 積む）。
.diagnostics_snapshot.json

# Compiled shaders
*.cso
*.pdb

# Claude Code
.claude/

# Generated per-build asset key (never commit)
src/core/generated/

# Editor / runtime cache
imgui.ini
assets/.thumbcache/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# ビルド済みインストーラー (setup.exe)
installer/output/

# 配布リリース zip（GitHub Release に添付済み。リポジトリには入れない）
/DX12Engine-v*.zip

# --validate CLI の出力（実行のたびに生成される）
validate_report.txt

# 実行時に出る生成物（コミットしない）
build-tests/
dx12_crash.dmp
dx12_crash.log
dx12_engine.log
mcp_screenshot.png
mcp_screenshot_final.png
mcp_ui_screenshot.png
