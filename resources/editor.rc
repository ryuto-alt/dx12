#include "resource.h"

// エディタ（DX12Engine.exe）だけに付けるリソース。ゲームのランタイム（GameRuntime.exe）には入れない。
// アイコンとマニフェストは両方の exe 共通なので app.rc に残す。
// 識別用の RCDATA（エディタの exe であることの印。pe_resources.py の `has` で確かめる）。
UNO_EDITOR_MARKER RCDATA
BEGIN
    "uno-editor\0"
END

// 他のレーンが足すエディタ専用リソース（スプラッシュの起動音など）は、レーンごとのブロックに書く。
// ==== lane-A begin ====
// ==== lane-A end ====
// ==== lane-B begin ====
// 起動音 Calibrate（W1-BD1）。完成した master（full / Reduce Motion 版）と、遅い経路用のステム。
// 資産の正は assets/editor/sounds/calibrate/（tools/gen_boot_sound_calibrate.py の出力）。ここ（エディタの exe の RCDATA）にだけ埋め込む。
// 時刻・パンは src/core/SplashCalibrateEvents.h。ゲームのランタイム（app.rc）には入れない。
