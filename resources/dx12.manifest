<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  DX12Engine / GameRuntime 共通のアプリケーションマニフェスト。
  ★DPI: Per-Monitor V2。OS の表示倍率(125% / 150% ...)を持つモニターごとに、ウィンドウは物理ピクセルで動く
    （Windows による引き伸ばしをしない）。倍率が違うモニターへ動かした時・実行中に倍率を変えた時は WM_DPICHANGED が届く。
    Windows 10 1607 未満では dpiAware(true/pm)へ落ちる。マニフェストが効かない経路のため、main.cpp でも
    SetProcessDpiAwarenessContext を最初期に呼んでいる（二重指定は無害）。
  ★activeCodePage=UTF-8（Windows 10 1903 以降）: プロセスの ANSI コードページを UTF-8 にする。
    エンジン内の文字列は UTF-8 だが、std::filesystem::path(std::string) / fopen / ifstream(std::string) などの
    ナロー API は ANSI コードページで解釈する。日本語 Windows の既定（CP932）のままだと、日本語を含むパス
    （OneDrive の「ドキュメント」、日本語のユーザー名）で変換に失敗して例外（No mapping for the Unicode character）
    になり、プロジェクトを開いた瞬間に落ちていた（v2.5.1 まで。src 全体でナローのパス生成が約 300 か所あるので、
    個別に直すより全体の解釈を UTF-8 にそろえる）。1903 未満では無視されて従来どおり。
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2,PerMonitor</dpiAwareness>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
