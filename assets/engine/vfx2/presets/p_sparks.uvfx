{
  "uvfx": 1,
  "name": "p_sparks",
  "duration": 2.4,
  "loop": true,
  "emitters": [
    {
      "name": "burst",
      "maxParticles": 192,
      "spawn": { "rate": 0, "bursts": [ { "t": 0, "count": 80 }, { "t": 1.2, "count": 60 } ] },
      "init": [
        { "module": "shape", "kind": "sphere", "radius": 0.05 },
        { "module": "velocity", "mode": "direction", "direction": [0, 1, 0], "speed": [1.5, 4.0], "spread": 55 },
        { "module": "lifetime", "range": [0.6, 1.4] },
        { "module": "size", "start": [0.04, 0.07], "end": [0.01, 0.02] },
        { "module": "color", "start": [7.0, 3.0, 0.8, 1.0], "end": [1.5, 0.2, 0.0, 0.0], "variation": 0.1 }
      ],
      "update": [
        { "module": "gravity", "value": [0, -9.8, 0] },
        { "module": "drag", "coefficient": 0.5 },
        { "module": "floor", "height": 0.0, "bounce": 0.35, "friction": 0.4 }
      ],
      "render": { "kind": "sprite", "blend": "additive", "fade": "quad", "softDistance": 0.15, "intensity": 1.0, "stretch": 1.0 }
    }
  ]
}
