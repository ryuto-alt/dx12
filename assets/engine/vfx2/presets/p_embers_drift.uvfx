{
  "uvfx": 1,
  "name": "p_embers_drift",
  "duration": 0,
  "loop": true,
  "emitters": [
    {
      "name": "embers",
      "maxParticles": 96,
      "spawn": { "rate": 12 },
      "init": [
        { "module": "shape", "kind": "box", "size": [2.5, 0.2, 2.5] },
        { "module": "velocity", "mode": "direction", "direction": [0, 1, 0], "speed": [0.25, 0.6], "spread": 35 },
        { "module": "lifetime", "range": [5.0, 8.0] },
        { "module": "size", "start": [0.09, 0.14], "end": [0.07, 0.1] },
        { "module": "color", "start": [1.0, 1.0, 1.0, 1.0], "end": [1.0, 1.0, 1.0, 1.0], "variation": 0.0 },
        { "module": "rotation", "angle": [0, 0], "rate": [0, 0] }
      ],
      "update": [
        { "module": "drag", "coefficient": 0.6 },
        { "module": "curlNoise", "strength": 0.7, "scale": 0.6, "speed": 0.2 }
      ],
      "render": {
        "kind": "flipbook", "blend": "additive", "fade": "inout", "softDistance": 0.2, "intensity": 1.0,
        "texture": "engine/vfx/embers.dds",
        "flipbook": { "cols": 4, "rows": 4, "frames": 16, "fps": 0, "channels": "fire", "anchor": "center",
                      "tempMin": 900, "tempMax": 1800, "emission": 12.0, "erodeStart": 0.7, "erodeWidth": 0.2 }
      }
    }
  ]
}
