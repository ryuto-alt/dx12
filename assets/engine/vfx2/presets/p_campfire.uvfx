{
  "uvfx": 1,
  "name": "p_campfire",
  "duration": 0,
  "loop": true,
  "emitters": [
    {
      "name": "flame",
      "maxParticles": 12,
      "spawn": { "rate": 3 },
      "init": [
        { "module": "shape", "kind": "disc", "radius": 0.08 },
        { "module": "velocity", "mode": "direction", "direction": [0, 1, 0], "speed": [0, 0], "spread": 0 },
        { "module": "lifetime", "range": [2.8, 3.2] },
        { "module": "size", "start": [1.0, 1.25], "end": [1.0, 1.25] },
        { "module": "color", "start": [1.0, 1.0, 1.0, 1.0], "end": [1.0, 1.0, 1.0, 1.0], "variation": 0.0 },
        { "module": "rotation", "angle": [0, 0], "rate": [0, 0] }
      ],
      "update": [],
      "render": {
        "kind": "flipbook", "blend": "additive", "fade": "inout", "softDistance": 0.3, "intensity": 1.0,
        "texture": "engine/vfx/fire_flipbook.dds",
        "flipbook": { "cols": 6, "rows": 6, "frames": 36, "fps": 12, "channels": "fire", "mv": "engine/vfx/fire_mv.dds", "mvRange": 0.5,
                      "anchor": "bottom", "tempMin": 1000, "tempMax": 2400, "emission": 10.0, "erodeStart": 0.6, "erodeWidth": 0.15 }
      }
    },
    {
      "name": "smoke",
      "maxParticles": 20,
      "spawn": { "rate": 2.5 },
      "init": [
        { "module": "shape", "kind": "disc", "radius": 0.06 },
        { "module": "velocity", "mode": "direction", "direction": [0, 1, 0], "speed": [0.55, 0.95], "spread": 8 },
        { "module": "lifetime", "range": [5.0, 7.0] },
        { "module": "size", "start": [0.55, 0.75], "end": [1.4, 1.9] },
        { "module": "color", "start": [0.5, 0.48, 0.46, 0.55], "end": [0.32, 0.31, 0.3, 0.0], "variation": 0.1 },
        { "module": "rotation", "angle": [0, 0], "rate": [0, 0] }
      ],
      "update": [
        { "module": "drag", "coefficient": 0.8 },
        { "module": "curlNoise", "strength": 0.6, "scale": 0.8, "speed": 0.3 }
      ],
      "render": {
        "kind": "flipbook", "blend": "alpha", "fade": "inout", "softDistance": 0.5, "intensity": 1.0,
        "texture": "engine/vfx/smoke_6way_rlu.dds",
        "flipbook": { "cols": 6, "rows": 6, "frames": 36, "fps": 12, "channels": "smoke6way", "dbf": "engine/vfx/smoke_6way_dbf.dds",
                      "mv": "engine/vfx/smoke_mv.dds", "mvRange": 0.5, "anchor": "bottom", "rootFade": 0.15, "erodeStart": 0.5, "erodeWidth": 0.2 }
      }
    },
    {
      "name": "sparks",
      "maxParticles": 64,
      "spawn": { "rate": 9 },
      "init": [
        { "module": "shape", "kind": "sphere", "radius": 0.1 },
        { "module": "velocity", "mode": "direction", "direction": [0, 1, 0], "speed": [1.2, 2.8], "spread": 28 },
